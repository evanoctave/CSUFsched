{
  "name": "@csufsched/scraper-csuf",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "scrape:full": "node --experimental-strip-types src/cli.ts full",
    "scrape:status": "node --experimental-strip-types src/cli.ts status",
    "record-fixtures": "node --experimental-strip-types scripts/record-fixtures.ts"
  },
  "dependencies": {
    "@csufsched/db": "workspace:*",
    "@csufsched/types": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  }
}
